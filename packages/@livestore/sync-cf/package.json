  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livestorejs/livestore.git"
  },
  "exports": {
    "./cf-worker": "./src/cf-worker/mod.ts",
    "./client": "./src/client/mod.ts",
    "./common": "./src/common/mod.ts"
