    "@livestore/utils": "workspace:^"
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.1.0",
    "@effect/platform-browser": "4.1.0",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@effect/vitest": "4.1.0",
    "@livestore/utils-dev": "workspace:^",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.2.0",
    "@standard-schema/spec": "1.1.0",
    "effect": "4.1.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "^4.1.0",
    "@effect/platform-browser": "^4.1.0",
    "@effect/platform-bun": "^4.1.0",
    "@effect/platform-node": "^4.1.0",
    "@effect/platform-node-shared": "^4.1.0",
    "@effect/vitest": "^4.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.2.0",
    "@standard-schema/spec": "^1.1.0",
    "effect": "^4.1.0"
